VITE_FIREBASE_DATABASE_ID=ai-studio-eduglobal365-43dec706-433e-4f7d-a1b7-7f5e31fbb01d
# Cuenta de servicio en Base64 de UNA línea (paywall real)
FIREBASE_SERVICE_ACCOUNT_B64=<BASE64_DE_CUENTA_DE_SERVICIO>

# ========================================
# 💳 WOMPI - Pasarela de Pagos Colombia
# Nombres REALES de los secrets en AI Studio / Cloud Run
# ========================================
# Pública (frontend): expuesta con prefijo VITE_
VITE_WOMPI_PUBLIC_KEY=pub_prod_XXXXXXXXXXXXXXX
# Privadas (backend): NUNCA expuestas al frontend
WOMPI_PRIVATE_KEY_PROD=prv_prod_XXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=prod_integrity_XXXXXXXXXXXXXXX
WOMPI_EVENT_SECRET_PROD=prod_events_XXXXXXXXXXXXXXX
# Ambiente: production | sandbox
WOMPI_ENV=production

